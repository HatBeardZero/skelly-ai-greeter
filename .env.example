# Copy to ~/.skelly_env and fill in:  cp .env.example ~/.skelly_env && chmod 600 ~/.skelly_env
# One KEY=value per line, no "export". Wrap any value that contains spaces in double
# quotes (SOX_EFFECT below): systemd strips the quotes, and it also lets you load this
# file in a shell with `set -a; source ~/.skelly_env; set +a` without errors.
# Never commit the filled-in file.

# --- required ---
ANTHROPIC_API_KEY=
# The Skelly's BLE control address (advertises as "Animated Skelly")
SKELLY_BLE_ADDR=AA:BB:CC:DD:EE:FF
# The Skelly speaker's classic Bluetooth address ("Animated Skelly(Live)")
SKELLY_CLASSIC_MAC=AA:BB:CC:DD:EE:00
# Base URL of Frigate (the greeter fetches /api/<camera>/latest.jpg?h=720)
FRIGATE_URL=http://frigate.local:5000

# --- optional (defaults shown) ---
# DEFAULT_CAMERA=front_door
# SKELLY_URL=http://localhost:8765
# CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_EFFORT=
# PIPER_BIN=~/greeter-venv/bin/piper
# PIPER_VOICE=~/voices/en_US-ryan-medium.onnx
# SOX_EFFECT="gain -3 pitch -600 bass 6 overdrive 6 tremolo 7 30 reverb 50 50 80 norm -3"
# FILLER_DIR=~/fillers
# COOLDOWN_SECONDS=20
# SNAPSHOT_DELAY=1
# On a fast camera feed (a Frigate fetch under 0.1 s) 0.5 and 0.5 below save about a second.
# Frames sent to Claude per press, and the gap between them in seconds. Two frames
# catch people looking away or mid-stride. Set SNAPSHOT_COUNT=1 for the old behaviour.
# SNAPSHOT_COUNT=2
# SNAPSHOT_GAP=1
# KEEPALIVE_SECONDS=20
# PORT=8766
# Keep a copy of the latest camera frames at /tmp/last_snapshot_1.jpg, _2.jpg (debugging only)
# SAVE_SNAPSHOT=0
